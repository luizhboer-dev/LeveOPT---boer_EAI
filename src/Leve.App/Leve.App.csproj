<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Leve</AssemblyName>
    <RootNamespace>Leve.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Um único Leve.exe, dependente do .NET Desktop Runtime 10 (sem runtime embutido = exe pequeno). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Leve.Core\Leve.Core.csproj" />
    <ProjectReference Include="..\Leve.Windows\Leve.Windows.csproj" />
  </ItemGroup>

</Project>
